# ==============================================================================
# CertFlow configuration template (.env.example)
#
# 1. Copy this file to ".env" in the same folder (copy .env.example .env)
# 2. Fill in the values marked  <-- CHANGE
# 3. Restart the backend. It reads .env only at startup.
#
# ".env" is git-ignored. Never commit it or share it: it holds your passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE   (pick ONE option, leave the others commented out)
# ------------------------------------------------------------------------------

# Option A: embedded H2 file database. Nothing to install. RECOMMENDED to start.
# Data is stored in certflow-api/data/
DATABASE_URL=jdbc:h2:file:./data/certflowdb;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
DATABASE_USER=sa
DATABASE_PASSWORD=
DATABASE_DRIVER=org.h2.Driver

# Option B: hosted PostgreSQL (Supabase / Neon / RDS)
# DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your_database_password
# DATABASE_DRIVER=org.postgresql.Driver

# Option C: local PostgreSQL on port 5432
# DATABASE_URL=jdbc:postgresql://localhost:5432/certflow
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_DRIVER=org.postgresql.Driver

# ------------------------------------------------------------------------------
# 2. EMAIL (SMTP)   sends sign-up codes, password resets and certificate PDFs
# ------------------------------------------------------------------------------

# Option A: your Gmail account
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below. Use the App Password, NOT your Gmail password.
# SMTP_FROM must be the same address as SMTP_USERNAME. Gmail allows about
# 500 emails a day on a normal account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# CHANGE THE VALUE BELOW
SMTP_USERNAME=your_email@gmail.com
# CHANGE THE VALUE BELOW
SMTP_PASSWORD=your_16_char_app_password
# CHANGE THE VALUE BELOW
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=CertFlow

# Option B: local test inbox (Mailpit, http://localhost:8025). No real email is sent.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@certflow.local
# SMTP_FROM_NAME=CertFlow

# ------------------------------------------------------------------------------
# 3. SECURITY AND URLS
# ------------------------------------------------------------------------------

# Secret used to sign login tokens. Use a long random value (64+ hex characters).
# Generate one:  PowerShell  ->  -join ((1..64) | % { '{0:X}' -f (Get-Random -Max 16) })
# CHANGE THE VALUE BELOW
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRATION_MS=86400000

# Where the frontend runs. Verification links and QR codes use these.
# When you deploy, change them to your public address.
APP_BASE_URL=http://localhost:5173
PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verify

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED MODE ONLY (docker compose up). Ignored by the simple local run.
# ------------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_CONSUMER_GROUP_PDF=certflow-pdf-workers
# KAFKA_CONSUMER_GROUP_EMAIL=certflow-email-workers
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET_TEMPLATES=certflow-templates
# S3_BUCKET_CERTIFICATES=certflow-certificates
# S3_REGION=us-east-1
