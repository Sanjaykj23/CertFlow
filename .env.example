# ==============================================================================
# CertFlow Configuration (.env.example)
# Copy this file to .env and configure your environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------

# OPTION A: Hosted Cloud PostgreSQL (Supabase / Neon / Aiven / RDS) - RECOMMENDED
DATABASE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password
DATABASE_DRIVER=org.postgresql.Driver

# OPTION B: Local Zero-Setup Embedded Database
# Automatically saves all users, events, and certificates into ./data/certflowdb
# DATABASE_URL=jdbc:h2:file:./data/certflowdb;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
# DATABASE_USER=sa
# DATABASE_PASSWORD=
# DATABASE_DRIVER=org.h2.Driver

# OPTION C: Local Installed PostgreSQL Server (Port 5432)
# DATABASE_URL=jdbc:postgresql://localhost:5432/certflow
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_DRIVER=org.postgresql.Driver

# OPTION D: Docker Compose (CockroachDB)
# DATABASE_URL=jdbc:postgresql://localhost:26257/certflow?sslmode=disable
# DATABASE_USER=root
# DATABASE_PASSWORD=root
# DATABASE_DRIVER=org.postgresql.Driver

# ------------------------------------------------------------------------------
# 2. SMTP EMAIL DELIVERY CONFIGURATION
# ------------------------------------------------------------------------------
# CertFlow delivers registration 2FA OTP codes, password resets, and certificates
# with high-res PDF attachments directly via SMTP.

# Option A: Gmail SMTP (Requires 2-Factor Authentication + 16-character App Password)
# Generate App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=CertFlow Platform

# Option B: Local Development (Mailpit)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@certflow.io
# SMTP_FROM_NAME=CertFlow Platform

# ------------------------------------------------------------------------------
# 3. REDIS & KAFKA (Optional / Zero-Docker Local Mode automatically skips these)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_PDF=certflow-pdf-workers
KAFKA_CONSUMER_GROUP_EMAIL=certflow-email-workers

# ------------------------------------------------------------------------------
# 4. S3 / OBJECT STORAGE (Optional: Local mode saves to certflow-api/storage-data)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_TEMPLATES=certflow-templates
S3_BUCKET_CERTIFICATES=certflow-certificates
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# 5. SECURITY & APPLICATION URLs
# ------------------------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
APP_BASE_URL=http://localhost:5173
PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verify
