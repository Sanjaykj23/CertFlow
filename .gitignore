target/
**/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven Release & Dependency Artifacts
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# Local Storage & Database Directories
data/
**/data/
storage-data/
**/storage-data/
*.db
*.mv.db
*.trace.db

# Node.js & Frontend Build Outputs
node_modules/
**/node_modules/
dist/
**/dist/
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Crash Reports & Log Files
*.log
**/logs/
hs_err_pid*
replay_pid*

